{
  "manifest_version": 2,
  "name": "YTM Audio Saver",
  "version": "1.0.12",
  "description": "Audio-only YouTube Music on the free tier: blocks video streams, keeps the best free audio format, and gives YouTube Music a clean design.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "https://music.youtube.com/*",
    "*://*.googlevideo.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content-bridge.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "YTM Audio Saver",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{c83e3d5a-dd07-4678-a532-e6fcac0dacbc}",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/javiergarval/ytm-audio-saver/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
